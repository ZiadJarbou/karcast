# Copy to .env for local development. Do not commit real secrets.
PORT=4173
WEBSITE_URL=https://karcast.app

# Contact form email provider. The current implementation supports Resend.
# Leave disabled until a verified sender/domain and API key are configured.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=KarCast <hello@karcast.app>

# Comma-separated origins allowed to submit the contact form.
ALLOWED_ORIGINS=http://localhost:4173,https://karcast.app
